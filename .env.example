# =============================================================================
# YouTube MCP Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For development, also create .env.development (gitignored)
# For testing, create .env.test (gitignored)
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=youtube-mcp-server
APP_VERSION=0.1.0
NODE_ENV=development

# Transport: stdio (default, for Claude Code), http, sse
MCP_TRANSPORT=stdio

# -----------------------------------------------------------------------------
# Transcript Extraction
# -----------------------------------------------------------------------------
# Preferred source: youtube-transcript-api (fast) or yt-dlp (robust fallback)
TRANSCRIPT_PREFERRED_SOURCE=youtube-transcript-api
TRANSCRIPT_FALLBACK_TO_YT_DLP=true
# Path to yt-dlp binary (optional, auto-detected if in PATH)
# TRANSCRIPT_YT_DLP_PATH=/usr/local/bin/yt-dlp
TRANSCRIPT_DEFAULT_LANGUAGE=en
TRANSCRIPT_TIMEOUT_MS=30000
TRANSCRIPT_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Summarization / LLM
# -----------------------------------------------------------------------------
# Provider: claude, openai, or ollama
SUMMARIZATION_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=8192
CLAUDE_TEMPERATURE=0.3
# CLAUDE_BASE_URL=https://api.anthropic.com (optional, for proxies)

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3
# OPENAI_BASE_URL=https://api.openai.com/v1 (optional)
# OPENAI_ORGANIZATION=org-xxx (optional)

# Ollama (Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=5m

# Summarization behavior
SUMMARIZATION_DEFAULT_STYLE=detailed
SUMMARIZATION_MAX_TRANSCRIPT_TOKENS=100000
SUMMARIZATION_CHUNK_SIZE_TOKENS=8000
SUMMARIZATION_CHUNK_OVERLAP_TOKENS=500
SUMMARIZATION_ENABLE_CHUNKING=true
# SUMMARIZATION_SYSTEM_PROMPT= (optional, custom system prompt)

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
# Type: sqlite (file-based), redis (distributed), memory (ephemeral)
CACHE_TYPE=sqlite
CACHE_SQLITE_PATH=./data/cache.db
# CACHE_REDIS_URL=redis://localhost:6379
CACHE_REDIS_KEY_PREFIX=yt-mcp:
CACHE_TTL_SECONDS=604800
CACHE_MAX_ENTRIES=10000
CACHE_CLEANUP_INTERVAL_MS=3600000
CACHE_VACUUM_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=30
RATE_LIMIT_RPH=200
RATE_LIMIT_RPD=1000
RATE_LIMIT_BURST_ALLOWANCE=5

# -----------------------------------------------------------------------------
# HTTP/SSE Server (only used when MCP_TRANSPORT=http or sse)
# -----------------------------------------------------------------------------
HTTP_ENABLED=false
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_CORS_ENABLED=true
HTTP_CORS_ORIGIN=*
HTTP_CORS_CREDENTIALS=false
HTTP_AUTH_ENABLED=false
# HTTP_AUTH_API_KEYS=key1,key2,key3 (comma-separated)
HTTP_AUTH_HEADER_NAME=x-api-key
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_BODY_LIMIT=1mb

# -----------------------------------------------------------------------------
# YouTube Data API (optional, for search_videos tool)
# -----------------------------------------------------------------------------
YOUTUBE_DATA_API_ENABLED=false
YOUTUBE_DATA_API_KEY=your-api-key
YOUTUBE_DATA_API_QUOTA_PER_DAY=10000
YOUTUBE_DATA_API_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY_PRINT=true
LOG_DEST=stdout
# LOG_REDACT_PATHS=*.apiKey,*.authorization,*.cookie
